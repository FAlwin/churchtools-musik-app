# ── excel-sync – optionaler Mini-Dienst der ECG (#177, PR 2) ─────────────────
# Gleicht die Musikteam-Excel (OneDrive) beidseitig mit den ChurchTools-Abwesenheiten ab.
# Andere Gemeinden brauchen diesen Dienst NICHT – die App funktioniert ohne ihn vollständig.
# Fehlt einer der Pflichtwerte, startet der Dienst bewusst nicht.

# ChurchTools – Basis-URL und ein SERVICE-Token (eigenes Technik-Konto, NICHT der Token einer Person).
# Der Token muss Abwesenheiten aller Musiker lesen/schreiben und Personen suchen dürfen.
CHURCHTOOLS_BASE_URL=https://deine-gemeinde.church.tools
CHURCHTOOLS_SERVICE_TOKEN=
# Abwesenheitsgrund, den der Dienst setzt (ECG: 1 = „Abwesend").
CHURCHTOOLS_ABSENCE_REASON_ID=1

# Microsoft Graph (App-Registrierung mit Client-Credentials; braucht Files.ReadWrite auf die Datei).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Besitzer der Excel in OneDrive und die Datei-ID (siehe Alt-Planner `get_file_id.py`).
ONEDRIVE_USER=
EXCEL_FILE_ID=
# Tabellenblatt – Standard: das laufende Jahr (die Excel hat je Jahr ein Blatt).
# EXCEL_WORKSHEET=2026

# Ablauf
# Trockenlauf: nur ausrechnen und protokollieren, NICHTS schreiben. Standard true – erst nach
# einem geprüften Trockenlauf-Protokoll auf false stellen (Testfall TF-VERF-04).
SYNC_DRY_RUN=true
# Abstand zwischen zwei Läufen in Minuten (0 = nur beim Start einmal).
SYNC_INTERVAL_MIN=10
# Baseline-Datei (Stand des letzten Abgleichs) – MUSS auf einem Volume liegen.
SYNC_BASELINE_PATH=./data/sync-baseline.json
# Status-/Health-Port (nur GET, keine Schreibwege)
PORT=3010
