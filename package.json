{
  "name": "churchtools-musik-app",
  "version": "0.1.0",
  "private": true,
  "description": "Worship-Charts-PWA für ChurchTools – Chord Charts aus der Setlist, automatisch transponiert",
  "license": "MIT",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspace=client",
    "test:e2e": "playwright test",
    "testplan": "node scripts/testplan.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,scss,json,md}\"",
    "doc-check": "node scripts/doc-kommentare.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.66.0"
  }
}
