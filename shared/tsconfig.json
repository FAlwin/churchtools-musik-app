{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  // Bewusst ein Sammel-Muster statt einer Ordnerliste: Bei "types/**, keys/**" fiel ein neu
  // angelegtes shared/tempo/ heraus und der Lint brach mit "not found by the project service".
  // Eine handgepflegte Liste vergisst man genau einmal.
  "include": ["**/*.ts"]
}
