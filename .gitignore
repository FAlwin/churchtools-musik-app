# Dependencies
node_modules/

# Builds
dist/
build/
client/dist/
server/dist/

# Environment / Secrets
# ALLE .env-Varianten ignorieren, NUR die Vorlagen nicht. Vorher waren die Namen einzeln
# aufgezählt (.env, .env.local, .env.*.local) – eine neue Variante wie `.env.churchtools-test`
# wäre damit ungeschützt im öffentlichen Repo gelandet. Beim Anlegen genau dieser Datei ist es
# aufgefallen; die Regel deckt jetzt auch alles ab, was künftig dazukommt.
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/

# Test / Coverage
coverage/

# Playwright (E2E)
test-results/
playwright-report/
blob-report/
.last-run.json

# Laufzeit-Branding (White-Label) – pro Instanz, nicht committen
data/
server/data/

# versehentliche shared-Build-Artefakte
shared/types/*.js
.e2e-data/
.entwuerfe/
